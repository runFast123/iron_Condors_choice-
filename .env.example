# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled-in file.
# The Choice API key is bound to a declared STATIC IP — see README "Static IP".
# ---------------------------------------------------------------------------

# --- Choice FinX credentials (ENGINE ONLY — the web app never sees these) ---
CHOICE_VENDOR_ID=
CHOICE_API_KEY=
CHOICE_MOBILE_NO=
# https://finxomne.choiceindia.com (default) or https://finx.choiceindia.com
CHOICE_BASE_URL=https://finxomne.choiceindia.com

# --- Database (shared by engine + web) ---
# Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Engine <-> Web shared secret for the command queue ---
ENGINE_SHARED_SECRET=

# --- Engine tuning ---
ENGINE_DATA_RATE_LIMIT=3.0        # Choice data requests per second
ENGINE_ORDER_RATE_LIMIT=5.0       # orders/sec. Keep < 10 to avoid SEBI algo registration
ENGINE_HTTP_CONNECT_TIMEOUT=5
ENGINE_HTTP_READ_TIMEOUT=30
ENGINE_LOG_LEVEL=INFO

# --- Trading safety ---
# paper | live   -- live additionally requires an explicit arm action in the UI
ENGINE_MODE=paper
ENGINE_MAX_CONDORS=20
ENGINE_DAILY_LOSS_LIMIT=25000     # INR; engine squares off and disarms past this
