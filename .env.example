# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled-in file.
#
# This is a MULTI-USER app: each user signs in with their OWN Choice
# credentials through the web UI. There is no master API key here.
# ---------------------------------------------------------------------------

# === WEB APP (Vercel or wherever the Next.js app runs) =====================
# URL of the engine, which must run on the machine whose static IP each user
# has declared against their Choice API key. Without this, sign-in cannot
# reach Choice and the app says so.
ENGINE_URL=https://web-red-gamma-78.vercel.app/

# Shared secret between the web app and the engine. Set the SAME value in both
# places so the engine is not an open login proxy if its port is reachable.
ENGINE_SHARED_SECRET=

# === ENGINE (the static-IP machine) ========================================
# Origins allowed to call the engine from a browser. Leave empty when only the
# Next.js server calls it (the normal setup).
ENGINE_ALLOWED_ORIGINS=

# Keeps user ids stable across engine restarts. Any long random string.
# Without it, ids rotate on restart and everyone is signed out.
USER_ID_SALT=

ENGINE_MAX_SESSIONS=50
ENGINE_STATE_DIR=engine/state

ENGINE_DATA_RATE_LIMIT=3.0        # Choice data requests per second
ENGINE_ORDER_RATE_LIMIT=5.0       # orders/sec. Keep < 10 to avoid SEBI algo registration
ENGINE_HTTP_CONNECT_TIMEOUT=5
ENGINE_HTTP_READ_TIMEOUT=30
ENGINE_LOG_LEVEL=INFO

# Trading safety (applies per user session)
ENGINE_MODE=paper                 # paper | live; live also needs an explicit arm
ENGINE_MAX_CONDORS=20
ENGINE_DAILY_LOSS_LIMIT=25000     # INR

# === SINGLE-USER CLI TOOLS ONLY ============================================
# Used by `engine.tools.doctor`, `.seed` and `.live` when you run them from a
# terminal. The web app does NOT read these -- it takes credentials per user
# at sign-in. Leave blank if you only use the web UI.
CHOICE_VENDOR_ID=
CHOICE_API_KEY=
CHOICE_MOBILE_NO=
CHOICE_BASE_URL=https://finxomne.choiceindia.com

# Public IP of this engine, as Choice sees it. Set to skip the lookup.
ENGINE_PUBLIC_IP=
